{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manimator-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
  "NEXT_PUBLIC_API_URL": "https://msh4r1f--manimator-api-generate.modal.run",
  "NEXT_PUBLIC_STATUS_URL": "https://msh4r1f--manimator-api-status.modal.run"
}

}
